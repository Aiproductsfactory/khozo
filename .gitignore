node_modules/
dist/
.env
*.log
server/data/uploads/*
!server/data/uploads/.gitkeep
server/data/db.json

# wrangler local state
.wrangler/

# Face-match test fixtures. These are photographs of real people; this
# repository is public, so the images stay local and only the README is tracked.
# See test-assets/faces/README.md.
test-assets/faces/*
!test-assets/faces/README.md

# temp & generated artifacts
.tmp/
graphify-out/

# python cache
__pycache__/
*.pyc

# Agent worktrees
.claude/worktrees/

# Decks, PDFs and films in docs/ are shared by hand, not kept in the public
# repo. Two older .pptx decks were tracked before this rule and stay tracked.
docs/*.pdf
docs/*.pptx
docs/*.mp4
