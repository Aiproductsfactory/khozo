# Khozo API configuration. Copy to .env and fill in. .env is gitignored.

# --- Database -------------------------------------------------------------
# Supabase -> Project Settings -> Database -> Connection string -> URI.
# Use port 5432 (session pooler) for migrations/DDL, 6543 (transaction pooler)
# for the running API. Leave unset to keep the JSON file store.
DATABASE_URL=

# --- Security -------------------------------------------------------------
# Required in production; the server refuses to start without it.
KHOZO_JWT_SECRET=
KHOZO_EXPORT_SIGNING_KEY=

# --- Face matching --------------------------------------------------------
AARAKSHAK_API_KEY=
# Threshold sent to Aarakshak. 0.35 is calibrated; the provider default of 0.82
# rejects most genuine matches. See docs/DEPLOYMENT.md.
AARAKSHAK_THRESHOLD=0.35

# Fallback + second opinion on the top candidates.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
KHOZO_SECOND_OPINION_TOP_N=5
KHOZO_EXPORT_SIGNING_KEY_ID=khozo-prod-1
