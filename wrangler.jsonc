{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "khozo",
  "main": "worker/index.js",
  "compatibility_date": "2026-07-10",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // khozo.org is attached to this Worker as a Custom Domain rather than pointed
  // at an IP with an A record: there is no origin server to point at. Cloudflare
  // creates the DNS records and issues the certificate from this declaration.
  // A registrar's parked-domain A record left on the apex must be overridden, or
  // Cloudflare proxies it and keeps serving the placeholder page.
  "routes": [
    { "pattern": "khozo.org", "custom_domain": true },
    { "pattern": "www.khozo.org", "custom_domain": true }
  ],
  // Keep the workers.dev URL alive. Declaring "routes" above makes Wrangler
  // disable workers.dev by default, which would break khozo.<subdomain>.workers.dev
  // — the fallback API URL the mobile app ships with (mobile/app.config.js).
  "workers_dev": true,
  "build": {
    "command": "npm run build -w web",
    "cwd": "."
  },
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // The Worker must see these before the asset layer does. /api/* is the
    // API itself; /child/* is served by the Worker as the plain SPA document
    // with the default share card (worker/index.js childCaseDocument). No
    // case's name or photo is ever put in a preview: the public never sees
    // them. The Worker answers it only so an old case link lands on the app
    // rather than on the asset server's /index.html redirect.
    "run_worker_first": [
      "/api/*",
      "/child/*"
    ]
  },
  // Set API_ORIGIN as a Worker variable/secret in Cloudflare after hosting the Express API.
  // Example value: https://api.example.gov
  // Query caching MUST stay disabled on this Hyperdrive config:
  //   npx wrangler hyperdrive update <id> --caching-disabled
  //
  // With it on, a sighting submitted by a citizen was written to Postgres and
  // then absent from every officer's review queue, because the dashboards read
  // a cached result set that predated it. Caching is a reasonable trade for a
  // read-heavy site; it is not one for a queue where a delayed row is a child
  // nobody is looking for yet. Verify with `wrangler hyperdrive get <id>`.
  // Scheduled checks (worker/src/ops.js): every 15 minutes the Worker checks the
  // database, the face engine and the review backlog and alerts super admins;
  // at 20:30 UTC (02:00 IST) it also writes the encrypted nightly backup.
  "triggers": { "crons": ["*/15 * * * *", "30 20 * * *"] },
  // To turn on e-mail alerts and backups (both need the account owner):
  //   1. Email Sending: onboard khozo.org (Dashboard > Email Service), then add
  //        "send_email": [{ "name": "EMAIL" }]
  //      and set the secret KHOZO_ALERT_EMAIL (the recipient; kept out of this
  //      public file).
  //   2. R2: enable it, create the bucket "khozo-backups", then add
  //        "r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "khozo-backups" }]
  //      and set KHOZO_BACKUP_KEY (32 random bytes, base64; keep a copy offline,
  //      a backup cannot be restored without it).
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "f8ebd8b17c5449288a5bdaefb9ac57cd"
    }
  ],
  "observability": {
    "enabled": true
  }
}
