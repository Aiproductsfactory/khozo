{
  "name": "khozo-explainer",
  "version": "1.0.0",
  "private": true,
  "description": "Khozo's public explainer video, rendered with Remotion. See README.md.",
  "license": "Apache-2.0",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts Vertical out/khozo-explainer-vertical.mp4 && remotion render src/index.ts Landscape out/khozo-explainer-landscape.mp4",
    "render:vertical": "remotion render src/index.ts Vertical out/khozo-explainer-vertical.mp4",
    "render:landscape": "remotion render src/index.ts Landscape out/khozo-explainer-landscape.mp4",
    "still": "remotion still src/index.ts Vertical out/frame.png",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.300",
    "@remotion/google-fonts": "4.0.300",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.300"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "typescript": "5.6.3"
  }
}
