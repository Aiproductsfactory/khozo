{
  "name": "khozo",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "Project Khozo - reunite missing children with their families. An initiative by Aegis School of Data Science.",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "build": "npm run build -w web",
    "deploy": "npm run build && wrangler deploy",
    "dev": "concurrently -n server,web -c green,cyan \"npm run dev -w server\" \"npm run dev -w web\"",
    "dev:server": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "seed:test-data": "node scripts/seed-test-data.mjs",
    "test:accounts": "node scripts/test-accounts.mjs",
    "test:all": "npm run test:coverage && npm run smoke:api && npm run smoke:worker && npm run smoke:alerts && npm run smoke:intake && npm run smoke:match-pool && npm run smoke:match-engines && npm run smoke:face-index && npm run smoke:scope && npm run smoke:store && npm run smoke:web-routes && npm run smoke:pwa && npm run smoke:bulk-import && npm run smoke:audit-chain && npm run smoke:script-display",
    "test:coverage": "node scripts/api-coverage.mjs",
    "smoke:store": "node scripts/store-replica-smoke.mjs",
    "smoke:api": "node scripts/api-smoke.mjs",
    "smoke:worker": "node scripts/api-smoke.mjs --runtime worker",
    "smoke:web-routes": "node scripts/web-route-guards.mjs",
    "smoke:pwa": "node scripts/pwa-offline-smoke.mjs",
    "start": "npm run dev",
    "test:images": "node scripts/test-image-pipeline.mjs",
    "db:migrate": "node scripts/migrate-to-postgres.mjs",
    "db:migrate-photos": "node scripts/migrate-photos.mjs",
    "db:sightings": "node scripts/purge-test-sightings.mjs",
    "smoke:alerts": "node scripts/sighting-alert-smoke.mjs",
    "smoke:intake": "node scripts/intake-screening-smoke.mjs",
    "i18n:check": "node scripts/i18n-check.mjs",
    "smoke:match-pool": "node scripts/match-pool-smoke.mjs",
    "smoke:match-engines": "node scripts/match-engine-parity-smoke.mjs",
    "smoke:face-index": "node scripts/face-index-smoke.mjs",
    "smoke:scope": "node scripts/scope-smoke.mjs",
    "smoke:bulk-import": "node scripts/bulk-import-smoke.mjs",
    "smoke:audit-chain": "node scripts/audit-chain-smoke.mjs",
    "smoke:script-display": "node scripts/script-display-smoke.mjs"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "wrangler": "^4.110.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.8",
    "nanoid": "^6.0.1",
    "pg": "^8.22.0"
  }
}
